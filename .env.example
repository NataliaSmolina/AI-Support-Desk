# Все настройки проекта. Скопируйте в .env: cp .env.example .env
# Адреса указаны для запуска с компьютера (порты из infra/*/compose.yml).
# Сервисы внутри Docker обращаются по именам: http://tei:80

# --- TEI (infra/tei) ---
TEI_EMBED_URL=http://127.0.0.1:8081

# --- Telegram-бот (services/bot) ---
# Токен от @BotFather. Сюда НЕ вписывать — только в свой .env, он в .gitignore
BOT_TOKEN=
# Группа операторов: номера подскажет команда /chat_id, отправленная в группе.
# Пусто — карточки операторам не отправляются. THREAD_ID пустой — общая тема.
OPERATOR_CHAT_ID=
OPERATOR_THREAD_ID=

# --- Общее ---
# Сколько секунд ждать ответа от сервисов моделей
REQUEST_TIMEOUT_S=180

# --- PostgreSQL ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=логин
POSTGRES_PASSWORD=пароль
POSTGRES_DB=supportdesk
DATABASE_URL=url