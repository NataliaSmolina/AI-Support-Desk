# Все настройки проекта. Скопируйте в .env: cp .env.example .env
# Адреса указаны для запуска с компьютера (порты из infra/*/compose.yml).
# Сервисы внутри Docker обращаются по именам: http://tei:80

# --- TEI (infra/tei) ---
TEI_EMBED_URL=http://127.0.0.1:8081

# --- Telegram-бот (services/bot) ---
# Токен бота от @BotFather – укажите его только в своем .env
BOT_TOKEN=
# ID группы для карточек операторов – добавьте бота в группу и отправьте /chat_id
# Если ID пустой, карточки операторам не отправляются
OPERATOR_CHAT_ID=
# ID темы для карточек – отправьте /chat_id в нужной теме, пусто означает общую тему
OPERATOR_THREAD_ID=
# ID операторов в формате [123, 456] – свой ID можно увидеть в логе после /start
OPERATOR_IDS=[]

# --- Общее ---
# Сколько секунд ждать ответа от сервисов моделей
REQUEST_TIMEOUT_S=180

# --- PostgreSQL ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=логин
POSTGRES_PASSWORD=пароль
POSTGRES_DB=supportdesk
DATABASE_URL=url
